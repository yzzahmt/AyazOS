# AyazOS Plymouth theme (script module)
# A seamless 48-frame lensed black hole loop (bh-00.png .. bh-47.png, 400x400, transparent)
# with "Welcome to AyazOS" fading in below it. Includes password / question prompts and messages.

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# scale artwork with the screen height (artwork is authored for 1080p)
scale = screen_h / 1080.0;
if (scale < 0.7) scale = 0.7;

FRAMES = 48;
BH_SIZE = Math.Int(400 * scale);

# ---------------------------------------------------------------- black hole frames
for (i = 0; i < FRAMES; i++) {
    if (i < 10)
        fname = "bh-0" + i + ".png";
    else
        fname = "bh-" + i + ".png";
    img = Image(fname);
    bh_frames[i] = img.Scale(BH_SIZE, BH_SIZE);
}

bh_sprite = Sprite();
bh_sprite.SetImage(bh_frames[0]);
bh_x = screen_w / 2 - BH_SIZE / 2;
bh_y = screen_h * 0.40 - BH_SIZE / 2;
bh_sprite.SetPosition(bh_x, bh_y, 10);

# ---------------------------------------------------------------- welcome text
welcome_img = Image("welcome.png");
welcome_w = Math.Int(welcome_img.GetWidth() * scale);
welcome_h = Math.Int(welcome_img.GetHeight() * scale);
welcome_scaled = welcome_img.Scale(welcome_w, welcome_h);
welcome_sprite = Sprite();
welcome_sprite.SetImage(welcome_scaled);
welcome_sprite.SetPosition(screen_w / 2 - welcome_w / 2, bh_y + BH_SIZE + 12 * scale, 10);
welcome_sprite.SetOpacity(0.0);

# ---------------------------------------------------------------- animation (refresh callback, ~50 Hz)
counter = 0;

fun refresh_callback () {
    global.counter = global.counter + 1;
    # ~30 frames per second out of a 50 Hz refresh
    idx = Math.Int(global.counter * 0.6) % global.FRAMES;
    global.bh_sprite.SetImage(global.bh_frames[idx]);

    # fade the welcome text in after about 1 second, over about 1 second
    t = (global.counter - 50) / 50.0;
    if (t < 0) t = 0;
    if (t > 1) t = 1;
    global.welcome_sprite.SetOpacity(t);
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---------------------------------------------------------------- password / question prompt
box_img = Image("box.png");
entry_img = Image("entry.png");
bullet_img = Image("bullet.png");

box_w = Math.Int(box_img.GetWidth() * scale);
box_h = Math.Int(box_img.GetHeight() * scale);
entry_w = Math.Int(entry_img.GetWidth() * scale);
entry_h = Math.Int(entry_img.GetHeight() * scale);

box_x = screen_w / 2 - box_w / 2;
box_y = screen_h * 0.70;
entry_x = screen_w / 2 - entry_w / 2;
entry_y = box_y + box_h - entry_h - 34 * scale;

box_sprite = Sprite(box_img.Scale(box_w, box_h));
box_sprite.SetPosition(box_x, box_y, 20);
box_sprite.SetOpacity(0.0);

entry_sprite = Sprite(entry_img.Scale(entry_w, entry_h));
entry_sprite.SetPosition(entry_x, entry_y, 21);
entry_sprite.SetOpacity(0.0);

prompt_sprite = Sprite();
prompt_sprite.SetPosition(box_x + 40 * scale, box_y + 30 * scale, 22);
prompt_sprite.SetOpacity(0.0);

MAX_BULLETS = 20;
bullet_size = Math.Int(bullet_img.GetWidth() * scale);
bullet_scaled = bullet_img.Scale(bullet_size, bullet_size);
for (i = 0; i < MAX_BULLETS; i++) {
    bullets[i] = Sprite(bullet_scaled);
    bullets[i].SetPosition(entry_x + 22 * scale + i * (bullet_size + 6 * scale),
                           entry_y + entry_h / 2 - bullet_size / 2, 22);
    bullets[i].SetOpacity(0.0);
}

fun show_prompt (prompt) {
    text = Image.Text(prompt, 0.78, 0.85, 1.0, 1.0, "Inter 15");
    global.prompt_sprite.SetImage(text);
    global.prompt_sprite.SetOpacity(1.0);
    global.box_sprite.SetOpacity(1.0);
    global.entry_sprite.SetOpacity(1.0);
}

fun hide_prompt () {
    global.prompt_sprite.SetOpacity(0.0);
    global.box_sprite.SetOpacity(0.0);
    global.entry_sprite.SetOpacity(0.0);
    for (i = 0; i < global.MAX_BULLETS; i++)
        global.bullets[i].SetOpacity(0.0);
}

fun display_password_callback (prompt, bullet_count) {
    show_prompt(prompt);
    for (i = 0; i < global.MAX_BULLETS; i++) {
        if (i < bullet_count)
            global.bullets[i].SetOpacity(1.0);
        else
            global.bullets[i].SetOpacity(0.0);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# plain-text question (e.g. a username): show what has been typed so far
question_sprite = Sprite();
question_sprite.SetPosition(entry_x + 22 * scale, entry_y + entry_h / 2 - 10 * scale, 22);

fun display_question_callback (prompt, entry_text) {
    show_prompt(prompt);
    text = Image.Text(entry_text, 1.0, 1.0, 1.0, 1.0, "Inter 15");
    global.question_sprite.SetImage(text);
    global.question_sprite.SetOpacity(1.0);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun display_normal_callback () {
    hide_prompt();
    global.question_sprite.SetOpacity(0.0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# ---------------------------------------------------------------- messages (fsck, errors, ...)
message_sprite = Sprite();
message_sprite.SetPosition(0, screen_h - 60 * scale, 30);

fun display_message_callback (text) {
    img = Image.Text(text, 0.66, 0.76, 0.95, 1.0, "Inter 13");
    global.message_sprite.SetImage(img);
    global.message_sprite.SetX(global.screen_w / 2 - img.GetWidth() / 2);
    global.message_sprite.SetOpacity(1.0);
}
Plymouth.SetDisplayMessageFunction(display_message_callback);

fun hide_message_callback (text) {
    global.message_sprite.SetOpacity(0.0);
}
Plymouth.SetHideMessageFunction(hide_message_callback);

# ---------------------------------------------------------------- shutdown / quit
fun quit_callback () {
    global.bh_sprite.SetOpacity(1.0);
}
Plymouth.SetQuitFunction(quit_callback);
