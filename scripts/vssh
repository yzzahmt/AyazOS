#!/bin/bash
# Derleme sanal makinesine SSH; known_hosts dahil her şey HDD'de.
. /Volumes/HDD/Projeler/Projeler/AyazOS/scripts/env.sh
exec ssh -F /dev/null -i $HOME/.ssh/id_ed25519 -o UserKnownHostsFile=$HOME/.ssh/known_hosts -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR -o ServerAliveInterval=30 -p 2222 ayaz@127.0.0.1 "$@"
