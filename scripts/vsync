#!/bin/bash
# Proje klasörünü derleme sanal makinesine eşitler (/home/ayaz/AyazOS).
. /Volumes/HDD/Projeler/Projeler/AyazOS/scripts/env.sh
exec rsync -a --delete --exclude .tc --exclude vm --exclude .git --exclude build \
  -e "ssh -F /dev/null -i $HOME/.ssh/id_ed25519 -o UserKnownHostsFile=$HOME/.ssh/known_hosts -o LogLevel=ERROR -p 2222" \
  "$AYAZ_ROOT/" ayaz@127.0.0.1:AyazOS/
