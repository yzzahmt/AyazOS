#!/bin/sh
# Kabuğu çalıştırır ve çökerse yeniden başlatır. Çökmeden sonra oturum güvenlik için
# yeniden kilitlenir (kilit ekranı kabukla aynı süreçte çalışır).
relock=""
fails=0
while :; do
    qs -c ayazos &
    pid=$!
    if [ -n "$relock" ]; then
        sleep 2
        qs -c ayazos ipc call lock lock >/dev/null 2>&1
    fi
    wait $pid
    code=$?
    [ "$code" -eq 0 ] && exit 0
    fails=$((fails + 1))
    [ "$fails" -gt 10 ] && exit 1
    relock=1
    sleep 1
done
